}

_read_editable_line(){   # $1=TTY prompt -> stdout; Readline editing, Ctrl-C cancels
  local prompt="$1" value
  if [ -t 0 ]; then
    # Plain `read` delegates editing to the terminal line discipline: arrows
    # arrive as literal escape bytes and multibyte backspace can corrupt Korean
    # text. `-e` uses Bash Readline for character-aware cursor/edit handling.
    IFS= read -e -r -p "$prompt" value < /dev/tty || return 1
  else
    IFS= read -r value || return 1
  fi
  printf '%s' "$value"
}
cmd_prompt_send(){
  need_tmux
  local cwin="${1:-}" text
  if [ -z "$cwin" ] || ! tmux list-panes -t "$cwin" >/dev/null 2>&1; then
    cwin=$(_cur_win)
  fi
  if ! text=$(_read_editable_line 'send-all  [Enter: send · Ctrl-C: cancel]  > '); then
    return 0
  fi
  [ -n "$text" ] || return 0
  _prompt_log_append "$cwin" "follow-up" "$text"
  _send_to_window "$cwin" "$text"
}
cmd_popup_send(){
  need_tmux
  local cwin qcwin
  cwin=$(_cur_win)
  qcwin=$(_sh_quote "$cwin")
  _tmux_popup -E "$INVOKE_CMD prompt-send $qcwin"
}

# Popup prompt -> `wtcp fork` from the focused agent pane. This is how a KEPT
