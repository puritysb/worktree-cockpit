# Worktrees wtcp itself created: the @worktree stamped on every agent pane of a
# `wt:` window (grid or kept session). This is `wtcp clean`'s scope — worktrees
# the user made with plain `workmux add` must survive.
_cockpit_worktrees(){
  local w wt
  while IFS= read -r w; do
    [ -n "$w" ] || continue
    while IFS= read -r wt; do
      [ -n "$wt" ] && printf '%s\n' "$wt"
    done < <(tmux list-panes -t "$w" -F '#{@worktree}' 2>/dev/null || true)
  done < <(tmux list-windows -F '#{window_id} #{window_name}' 2>/dev/null \
             | awk -v p="^${WIN_PREFIX}:" '$2 ~ p{print $1}' || true)
  return 0
}

cmd_clean(){
  need_repo
  local all=0 arg
  for arg in "$@"; do
    case "$arg" in
      --all) all=1 ;;
      *) die "clean: unknown option $arg (usage: wtcp clean [--all])" ;;
    esac
  done
  # 1) Remove worktrees FIRST. cmd_clean is often run from the grid's bottom bar
  #    pane; step 2 kills that window — which would terminate this script before
  #    the removal ran (the old "have to run clean twice" bug). Do removal first
  #    so it always completes even if killing our own window ends the script.
  if [ "$all" -eq 1 ]; then
    # `workmux remove --all -f` is repo-wide and ignores uncommitted changes, so
    # it also destroys worktrees the user is working in outside wtcp. Confirm.
    say "about to remove EVERY workmux worktree in this repo (except the main one),"
    say "including any you created with plain 'workmux add', uncommitted changes and all."
    local ans=""
    read -r -p "wtcp: continue? [y/N] " ans </dev/tty 2>/dev/null || ans=n
    case "$ans" in y|Y|yes|YES) ;; *) die "aborted (nothing removed)";; esac
    _wm remove --all -f
  else
    local wts=() wt
    while IFS= read -r wt; do [ -n "$wt" ] && wts+=("$wt"); done < <(_cockpit_worktrees)
    if [ ${#wts[@]} -eq 0 ]; then
      say "no wtcp round worktrees found — leaving your other workmux worktrees alone."
      say "  ('wtcp clean --all' removes every workmux worktree in this repo.)"
    else
      say "removing wtcp round worktrees + closing grid windows: ${wts[*]}"
      for wt in "${wts[@]}"; do _wm remove "$wt" -f || true; done
    fi
  fi
  # 2) Drop the session env this round published for teammate panes, and ONLY
  #    that: @cockpit_env lists what wtcp actually set, so a variable the user
  #    already had survives. Must run before the window kills below take the
  #    stamps (and this script) with them.
  local w cur; cur=$(_cur_win 2>/dev/null || true)
  local sess; sess=$(tmux display -p ${cur:+-t "$cur"} '#{session_name}' 2>/dev/null || true)
  while IFS= read -r w; do
    [ -n "$w" ] || continue
    _teammate_env_clear "$sess" "$(tmux show-options -wqv -t "$w" @cockpit_env 2>/dev/null || true)"
  done < <(tmux list-windows -F '#{window_id} #{window_name}' 2>/dev/null | awk -v p="^${WIN_PREFIX}:" '$2 ~ p{print $1}')
  # 3) Close any leftover grid windows (their joined panes aren't workmux-tracked
  #    so `remove` can't close them). Kill the window we're in LAST.
  while IFS= read -r w; do
    [ -n "$w" ] && [ "$w" != "$cur" ] && tmux kill-window -t "$w" 2>/dev/null || true
  done < <(tmux list-windows -F '#{window_id} #{window_name}' 2>/dev/null | awk -v p="^${WIN_PREFIX}:" '$2 ~ p{print $1}')
  case "$(tmux display -p '#{window_name}' 2>/dev/null || true)" in
    "${WIN_PREFIX}:"*) tmux kill-window -t "$cur" 2>/dev/null || true ;;
  esac
}

# Short aliases match the in-grid keybinding letters (b=start, s/p/f/x/a/g/r).
case "${1:-}" in
  start|broadcast|b) shift; cmd_broadcast "$@";;
  send|s)            shift; cmd_send "$@";;
  prompt-send)       shift; cmd_prompt_send "$@";;
  popup-send)        shift; cmd_popup_send "$@";;
  prompt-fork)       shift; cmd_prompt_fork "$@";;
  popup-fork)        shift; cmd_popup_fork "$@";;
  pick|p)            shift; cmd_pick "$@";;
  keep|k)            shift; cmd_keep "$@";;
  keep-menu)         shift; cmd_keep_menu "$@";;
  fork|f)            shift; cmd_fork "$@";;
  drop|x)            shift; cmd_drop "$@";;
  abandon|a)         shift; cmd_abandon "$@";;
  grid|g)            shift; cmd_grid "$@";;
  score|r)           shift; cmd_score "$@";;
  winner)            shift; cmd_winner "$@";;
  merge|m)           shift; cmd_merge "$@";;
  diff)              shift; cmd_diff "$@";;
  show)              shift; cmd_show "$@";;
  copy|cp)           shift; cmd_copy "$@";;
  agents)            shift; cmd_agents "$@";;
  setup)             shift; cmd_setup "$@";;
  bar-banner)        shift; cmd_bar_banner "$@";;
  status-watch)      shift; cmd_status_watch "$@";;
  doctor)            shift; cmd_doctor "$@";;
  list|ls)           shift; cmd_list "$@";;
  clean|clear)       shift; cmd_clean "$@";;
  ""|-h|--help|help) cmd_help;;
  *) die "unknown command: $1 (try: wtcp help)";;
esac
